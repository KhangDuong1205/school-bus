# OneMap Credentials (for auto-token generation)
# Get your email/password from: https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=your_email_here
ONEMAP_PASSWORD=your_password_here

# OneMap API Key (legacy/fallback)
ONEMAP_API_KEY=your_api_key_here

# AI Refinement (optional — only needed if you want to use the AI Refine feature)
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Free-tier API keys can only reach the gemini-2.5-flash family. Pro models
# (gemini-2.5-pro, gemini-3.1-pro-preview) require billing — quota=0 on free.
# GEMINI_REFINER_MODEL=gemini-2.5-flash
